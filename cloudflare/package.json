{
  "name": "vaultwarden-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "worker-build --release . -- --locked",
    "build:ci": "bash scripts/build-ci.sh",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy-ci.mjs",
    "deploy:ci": "node scripts/deploy-ci.mjs",
    "check": "cargo fmt --check && cargo clippy --locked --target wasm32-unknown-unknown -- -D warnings",
    "test": "node tests/integration.mjs",
    "web-vault": "python3 scripts/web-vault.py"
  },
  "devDependencies": {
    "@bitwarden/cli": "2026.7.0",
    "jose": "6.2.2",
    "playwright": "1.58.2",
    "wrangler": "4.149.0"
  }
}
